<?xml version="1.0" encoding="utf-8"?>
<!-- No user auth tokens or coin balances are backed up. Firestore/Firebase Auth
     hold the source of truth, so restoring an install regenerates local state. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
