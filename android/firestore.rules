rules_version = '2';

// AppTesting Firestore security rules.
//
// SECURITY MODEL
//   * Default deny. Every collection gets an explicit match block that opens
//     up only what a repository actually needs.
//   * Privileged writes do not exist for clients at all. App approval status,
//     user suspension, group documents and assignment creation are refused
//     here for everyone — including admins — and happen only through callable
//     Cloud Functions that run with Admin SDK credentials and re-verify the
//     caller's role server-side. Admin rights in these rules are therefore
//     strictly READ privileges, scoped to the collections the admin console
//     actually lists.
//   * `users.role` is never client-writable, which is what makes isAdmin()
//     safe to consult: it cannot be self-granted from the app.
//   * A suspended account keeps read access and can still sign out or leave a
//     group, but cannot submit apps, join groups, log testing days or claim
//     completion.
//   * `testingLogs` is entirely server-written. A testing day is recorded
//     only by the `recordTestingDay` callable, which derives the day key from
//     the server clock and the assignment's PINNED IANA timezone — so the
//     boundary is real local midnight, and a tampered device clock buys
//     nothing. Deterministic ids ("{cycleAssignmentId}__{yyyy-MM-dd}") plus
//     `tx.create` make a duplicate impossible at the storage layer.
//   * `testingAssignments` has no client-writable field at all. The pinned
//     commitment clock in particular is written once, at claim, and never
//     again: a deadline that could be edited afterwards would not be one.
//   * The Testing Coin wallet and its ledger are READ-ONLY to every client,
//     including admins. Balances move only inside Cloud Function
//     transactions, which derive the balance deltas from the entry kind
//     rather than accepting them from a caller.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers -------------------------------------------------

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function callerPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function callerExists() {
      return signedIn() && exists(callerPath());
    }

    // READ-ONLY privilege. See the security model note above: no rule in this
    // file grants an admin any write.
    //
    // `.get('role', 'member')` (not `.role`) is required, same reasoning as
    // isSuspended() below: `role` is set only by manually promoting an
    // account (no Cloud Function or client create path ever writes it), so
    // ordinary user docs have no such key. The default must stay the
    // non-admin state ('member') so a missing key can never grant admin.
    // This had no observed production impact — every call site in this file
    // is `isSelf(...) || isAdmin()` or `isAdmin() || (owner check)`, and CEL
    // resolves `a || b` to `true` when the non-erroring side is true — but it
    // is the same defect class as the isSuspended() bug that broke
    // testingLogs creates, so it is closed here before it causes one.
    function isAdmin() {
      return callerExists() && get(callerPath()).data.get('role', 'member') == 'admin';
    }

    // A caller with no profile document yet (brand new sign-in) counts as
    // active, so the first-run profile write is never locked out.
    //
    // `.get('isSuspended', false)` (not `.isSuspended`) is required: the
    // client-writable create fields never include `isSuspended` (only a
    // suspension by an admin Cloud Function sets it), so most user docs have
    // no such key at all. Dot access on a missing map key is a rules
    // evaluation ERROR, not `null`/`false` — confirmed via the Rules
    // Playground against a real production user doc with no `isSuspended`
    // field ("Property isSuspended is undefined on object"), which was the
    // actual root cause of every testingLogs create failing PERMISSION_DENIED
    // (activeUser() erroring out on the very first clause of that rule).
    // `Map.get(key, default)` reads the same field without throwing when the
    // key is absent.
    function isSuspended() {
      return callerExists() && get(callerPath()).data.get('isSuspended', false) == true;
    }
    function activeUser() { return signedIn() && !isSuspended(); }

    // "The incoming write only touches these keys."
    function onlyChanges(before, after, keys) {
      return after.diff(before).affectedKeys().hasOnly(keys);
    }

    // "The incoming create sets no keys outside this allow-list."
    function onlyHas(data, keys) {
      return data.keys().hasOnly(keys);
    }

    // `pad2`, `serverDayKey`, `assignmentPath` and `ownsActiveAssignment` were
    // removed here. They existed solely to validate a CLIENT-written
    // testingLogs create: the rule re-derived a UTC day key from
    // `request.time` and confirmed the caller owned an active assignment.
    // `recordTestingDay` does all of that server-side now, against the
    // assignment's pinned IANA timezone rather than UTC, so the helpers had no
    // remaining caller. Dead rule helpers are worth deleting rather than
    // keeping: they read as live protection when nothing invokes them.

    // Fields on `users/{uid}` the client may write on create.
    function userCreateAllowed(data, uid) {
      return onlyHas(data, ['uid', 'email', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid == uid;
    }

    // Fields on `users/{uid}` the client may write on update. role,
    // isSuspended, coinBalance and trustScore are absent by design.
    function userUpdateAllowed(before, after) {
      return onlyChanges(before, after,
        ['email', 'displayName', 'photoUrl', 'updatedAt']);
    }

    // ---------- users ---------------------------------------------------

    match /users/{userId} {
      // Admins read the roster for the admin console; everyone else sees
      // only themselves.
      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelf(userId)
        && userCreateAllowed(request.resource.data, userId);

      allow update: if isSelf(userId)
        && userUpdateAllowed(resource.data, request.resource.data);

      allow delete: if false;

      // ---- Testing Coin wallet ---------------------------------------
      //
      // Testing Coins are a COMMITMENT device: coins are staked on an
      // assignment, the same coins come back on success, and they are
      // forfeited on failure. They are not cash, are not withdrawable and
      // are not transferable between users.
      //
      // The cached balance document. Every field on it — available, locked,
      // forfeitedTotal, purchasedTotal, adjustmentNet — is server-derived
      // from the ledger below, and NONE of them is client-writable. A client
      // that could write any one of them could grant itself coins, unlock
      // its own stake, or erase a forfeit, which is the whole security model
      // of the wallet. `write` covers create, update and delete deliberately:
      // deleting this document would reset the balance just as effectively
      // as editing it.
      match /wallet/{walletDocId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      // Per-user append-only coin ledger — the source of truth the wallet
      // above is folded from. Only Cloud Functions write, and they use
      // `tx.create` with deterministic ids, so even server code cannot
      // overwrite an existing entry. Client writes are refused outright: an
      // update or delete here would rewrite financial history, and a create
      // would let a client mint its own balance change.
      match /coinTransactions/{txId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      // Per-user membership. Creating one is server-authoritative (the
      // joinGroup callable) so member cap, suspension and duplicate checks
      // cannot be bypassed by writing this document directly. Leaving stays
      // client-side — a user may always remove themselves.
      match /memberships/{groupId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if false;
        allow delete: if isSelf(userId);
      }

      // Per-user Quick Test daily counter. This document IS the rate limit:
      // the startQuickTest transaction reads it, which locks it, so
      // concurrent attempts serialize. A client that could write it could
      // reset its own count to zero and take unlimited Quick Tests, so every
      // client write is refused — including delete, which would do exactly
      // that. The client reads it only to render "N left today".
      match /quickTestDays/{dayKey} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      // Per-user-per-app Quick Test cooldown marker. Client-writable it would
      // be a one-line cooldown bypass, so it is server-only. Read access lets
      // the Apps screen grey out apps still in cooldown without a round trip.
      match /quickTestApps/{appId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ---------- apps ----------------------------------------------------

    match /apps/{appId} {
      // Any signed-in user can browse the catalog. If we ever want a
      // stricter view (e.g. only approved apps) that's a query filter,
      // not a rule — the mobile client already filters on `status`.
      allow read: if signedIn();

      // NOTE — Quick Test fields. `quickTestEnabled` (eligibility) and
      // `lastSurfacedAt` (pool rotation cursor) are server-only. They are
      // refused implicitly, because both the create and the update rule below
      // are closed allow-lists and neither field is on them. Do NOT add
      // either one to those lists: `quickTestEnabled` is what decides whether
      // an app is surfaced at all, and `lastSurfacedAt` is what keeps the
      // rotation fair, so a developer who could write either could promote
      // their own app into every user's pool indefinitely.

      // Create: the owner must be the authed user, the account must not be
      // suspended, status must start at pendingReview, and only the
      // client-writable fields may be set.
      allow create: if activeUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pendingReview'
        && onlyHas(request.resource.data, [
          'ownerId', 'appName', 'packageName', 'versionName',
          'playStoreUrl', 'closedTestingUrl', 'iconUrl',
          'description', 'status', 'createdAt', 'updatedAt'
        ]);

      // Update: only the owner can edit, they may change only these
      // profile fields, they can't advance the review status themselves,
      // and they can't change the ownerId (impersonation guard).
      // Review status moves only via the adminSetAppStatus callable.
      allow update: if activeUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && onlyChanges(resource.data, request.resource.data, [
          'appName', 'packageName', 'versionName',
          'playStoreUrl', 'closedTestingUrl', 'iconUrl',
          'description', 'updatedAt'
        ]);

      // Delete: owner only. Admin takedowns run server-side.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- groups --------------------------------------------------

    match /groups/{groupId} {
      // Any signed-in user can discover groups.
      allow read: if signedIn();
      // Groups are created and edited only by the adminUpsertGroup callable,
      // and memberCount only by syncGroupMemberCount.
      allow write: if false;

      // Server-maintained mirror of who is in the group. Written only by
      // syncGroupMemberCount; read by the owner of the row and by admins.
      match /members/{memberId} {
        allow read: if isSelf(memberId) || isAdmin();
        allow write: if false;
      }
    }

    // ---------- Quick Tests ---------------------------------------------

    // Server-maintained discovery pool. Any signed-in user reads it to learn
    // which apps to surface; nobody writes it from a client. Selection lives
    // on the server precisely so it cannot be steered: a client-side ordering
    // would let a caller reverse the rotation and pin the pool to the same
    // apps, or to their own.
    match /discovery/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Quick Test sessions.
    //
    // Every client write is refused. Sessions exist only via the
    // startQuickTest / completeQuickTest callables, which re-derive the day
    // key, the timestamps, the daily count and the cooldown server-side. A
    // client that could create one of these could bypass the daily limit, the
    // cooldown and the suspension check in a single write; one that could
    // update one could rewrite `openedAt` or `completedAt`.
    //
    // Read is scoped to the owner. Unlike testingLogs, a read of a document
    // that does not exist is NOT tolerated here: `uid` is part of the
    // deterministic id, so allowing a null resource would turn this into an
    // oracle for "did user X Quick Test app Y on date Z". The client never
    // needs that read — it learns its own state from the callable's return
    // value and from users/{uid}/quickTestApps.
    //
    // `.get('uid', '')` rather than `.data.uid`: dot access on a missing key
    // is a rules evaluation ERROR, not false. A malformed session document
    // would otherwise deny the owner's whole query instead of just that row.
    match /quickTestSessions/{sessionId} {
      allow read: if isAdmin()
        || (signedIn() && resource != null
            && resource.data.get('uid', '') == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---------- testingAssignments -------------------------------------

    match /testingAssignments/{assignmentId} {
      // A tester may read assignments assigned to them; a developer may
      // read assignments referencing their app so they can see progress;
      // an admin may read the queue for the console.
      //
      // Deliberately strict about missing documents: assignment ids are
      // deterministic ("{appId}__{testerId}"), so tolerating a null resource
      // here would let anyone probe whether a given user is testing a given
      // app. A lookup of a deleted assignment therefore surfaces as a
      // permission error rather than "not found", which the repository
      // reports as a generic failure.
      allow read: if isAdmin() || (signedIn() && (
        resource.data.testerId == request.auth.uid
          || resource.data.developerId == request.auth.uid
      ));

      // Assignments are created only by the `joinTestingAssignment` callable,
      // which locks the tester's coins, writes the active claim and creates
      // the cycle assignment in one transaction. The old push-matching
      // callable that created assignments with nothing staked behind them is
      // retired — see the header of functions/assignments.js.
      allow create: if false;

      // NO CLIENT WRITES AT ALL.
      //
      // A tester used to be allowed one update: flipping `status` to
      // `waitingForVerification` once the day count reached the requirement.
      // The testing engine removed the need for it — recording the fourteenth
      // qualifying day completes the commitment and returns the staked coins
      // in one server transaction, so there is nothing left for a tester to
      // ask for. With the need gone, the permission goes too.
      //
      // Every field on this document governs money or the clock that decides
      // it: commitmentAmount (how much is at stake), cycle (which commitment),
      // lockTxId and settlementTxId (which ledger entries moved the coins),
      // qualifyingDays and daysCompleted (whether the requirement was met),
      // timeZone / firstEligibleDayKey / lastEligibleDayKey / windowDays /
      // windowEndsAt / creditedOutageDays (the deadline itself), and testerId /
      // appId / developerId (whose coins). A client able to write any one of
      // them could unlock coins it never earned back, move its own deadline,
      // or forfeit someone else's stake.
      //
      // The pinned clock deserves a specific note: it is written exactly once,
      // by the claim transaction, and never again by anything. Immutability is
      // what makes it authoritative — a deadline that could be edited after the
      // commitment started would not be a deadline.
      allow update: if false;

      // Deleting an assignment would strand its locked coins: the ledger entry
      // and the wallet balance would survive with nothing left to settle
      // against. Only the settlement paths may end a commitment.
      allow delete: if false;
    }

    // ---------- activeClaims -------------------------------------------

    // At most one live commitment per (app, tester), id "{appId}__{testerId}".
    //
    // This document IS the concurrency guard for claiming: the join
    // transaction writes it with `tx.create`, so two simultaneous claims for
    // the same app collide and exactly one survives. It is also what stops a
    // second commitment starting while one is live.
    //
    // Every client write is refused, and `delete` matters as much as `create`:
    // a client that could delete its own claim could start a second commitment
    // on the same app while the first still holds coins, or clear the guard
    // that makes double-claiming impossible. The claim is removed only by the
    // settlement paths, inside the same transaction that moves the coins.
    match /activeClaims/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.testerId == request.auth.uid);
      allow write: if false;
    }

    // ---------- testingLogs --------------------------------------------

    match /testingLogs/{logId} {
      // A tester may read their own logs; admins read them for verification.
      //
      // `resource == null` is no longer tolerated. It existed because the
      // client's check-in transaction had to read the day's log before writing
      // it, which turned deterministic log ids into an existence oracle:
      // anyone who knew an assignment id could probe whether a given day was
      // logged. The callable does that read with Admin SDK credentials now, so
      // the allowance is gone and a lookup of a non-existent log is simply
      // denied.
      allow read: if isAdmin()
        || (signedIn() && resource.data.testerId == request.auth.uid);

      // NO CLIENT WRITES. Testing days are recorded only by the
      // `recordTestingDay` callable, running with Admin SDK credentials.
      //
      // This rule used to permit a client create, guarded by a `date` that had
      // to equal a day key derived from `request.time`. That was sound against
      // clock tampering, but it forced the testing day to roll over at UTC
      // midnight, because rules cannot see a tester's timezone — an Indian
      // tester's day flipped at 05:30 local. Moving the write server-side is
      // what buys a real local-midnight boundary: the callable knows the
      // assignment's PINNED IANA zone and derives the day itself.
      //
      // Closing the client path also closes two things the old comment here
      // flagged as open: the read-before-write oracle below, and the
      // possibility of a log existing without the matching progress update,
      // since both now happen in one transaction.
      //
      // A testing log is worth 1/14th of a 50-coin commitment, so `delete` is
      // refused as firmly as `create`: deleting a log would silently reduce a
      // tester's progress, and deleting the fourteenth would strip evidence
      // from a completed settlement.
      allow write: if false;
    }

    // ---------- systemHealth -------------------------------------------

    match /systemHealth/{dayKey} {
      // Readable by any signed-in user. A declared outage is not a secret -
      // a tester who lost a day to one is entitled to see that it was
      // acknowledged, and a support conversation goes better when both sides
      // can look at the same record.
      allow read: if signedIn();

      // NO CLIENT WRITES AT ALL.
      //
      // A degraded day extends the testing window of every commitment it
      // applies to. That makes this collection a direct lever on whether 50
      // staked coins are forfeited, and it is exactly what a tester about to
      // fail a commitment would forge: declare yesterday degraded, buy
      // another day, repeat. There is no amount of field validation that
      // would make a client write safe here, because the danger is not the
      // shape of the document - it is who gets to say a day was bad.
      //
      // The only writer is `adminDeclareOutage`, which runs with Admin SDK
      // credentials and re-verifies the caller's admin role against their
      // user document on every invocation. Note that `isAdmin()` in this file
      // grants READS only, and deliberately: an admin session compromised in
      // a browser still cannot write a single outage day.
      //
      // `delete` is refused as firmly as `create`. Withdrawing a
      // mis-declared day is `degraded: false` through the callable, which
      // keeps the record of who declared what and who withdrew it. Deleting
      // the document would silently re-expose every commitment that day was
      // protecting, with nothing left to explain why.
      allow write: if false;
    }

    // Anything not matched explicitly is denied. This is important:
    // future collections should get their own dedicated match block
    // that opens up only what the corresponding repository actually needs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
