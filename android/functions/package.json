{
  "name": "functions",
  "description": "Firebase Cloud Functions for AppTesting",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:emulator": "node --test --test-concurrency=1 \"test-emulator/*.test.js\"",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "private": true
}
